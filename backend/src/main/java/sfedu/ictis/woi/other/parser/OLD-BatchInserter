package sfedu.ictis.woi.other.parser;

import java.sql.*;
import java.util.*;
import java.util.logging.Level;
import java.util.logging.Logger;

public class BatchInserter {
    private static final Logger logger = Logger.getLogger(BatchInserter.class.getName());

    private final Connection conn;
    private final int batchSize;

    // Списки для накопления данных
    private final List<PoiItem> poiBatch = new ArrayList<>();
    private final List<TagItem> tagBatch = new ArrayList<>();
    private final List<LangItem> langBatch = new ArrayList<>();

    // Кэш сабкатегорий для быстрой проверки poi_system_tags (Key: "key:value", Value: subcategory_id)
    private final Map<String, Integer> subcategoryCache = new HashMap<>();

    public BatchInserter(Connection conn, int batchSize) {
        this.conn = conn;
        this.batchSize = batchSize;
        loadSubcategories();
    }

    private void loadSubcategories() {
        try (Statement stmt = conn.createStatement();
             ResultSet rs = stmt.executeQuery("SELECT id, subcategory_key, subcategory_value FROM subcategories")) {
            while (rs.next()) {
                String fullKey = rs.getString("subcategory_key") + ":" + rs.getString("subcategory_value");
                subcategoryCache.put(fullKey, rs.getInt("id"));
            }
            logger.info("Loaded " + subcategoryCache.size() + " subcategories for system tagging.");
        } catch (SQLException e) {
            logger.log(Level.SEVERE, "Failed to load subcategories cache", e);
        }
    }

    // Вспомогательные классы данных
    private record PoiItem(String type, long osmId, long uid, Timestamp ts, String wkt) {}
    private record TagItem(long osmId, String type, String key, String value) {}
    private record LangItem(long osmId, String type, String lang, String name, String desc) {}

    public void addPoi(String osmType, long osmId, long osmUid, Timestamp lastUpdate, String geomWkt) {
        poiBatch.add(new PoiItem(osmType, osmId, osmUid, lastUpdate, geomWkt));
        if (poiBatch.size() >= batchSize) {
            flush();
        }
    }

    public void addTag(long osmId, String type, String key, String value) {
        tagBatch.add(new TagItem(osmId, type, key, value));
    }

    public void addLang(long osmId, String type, String lang, String name, String desc) {
        langBatch.add(new LangItem(osmId, type, lang, name, desc));
    }

    public void flush() {
        if (poiBatch.isEmpty()) return;

        try {
            conn.setAutoCommit(false);

            // 1. Вставляем POIs (Upsert)
            insertPois();

            // 2. Вставляем теги OSM (с поиском внутреннего ID)
            insertOsmTags();

            // 3. Вставляем системные теги (авто-категоризация)
            insertSystemTags();

            // 4. Вставляем языковые данные
            insertLangs();

            conn.commit();
            clearBatches();
            logger.info("Batch flushed successfully");
        } catch (SQLException e) {
            try { conn.rollback(); } catch (SQLException ex) { logger.severe("Rollback failed"); }
            logger.log(Level.SEVERE, "Flush failed", e);
        } finally {
            try { conn.setAutoCommit(true); } catch (SQLException e) { /* ignore */ }
        }
    }

    private void insertPois() throws SQLException {//osm_uid не обновляется
        String sql = "INSERT INTO pois(osm_type, osm_id, osm_uid, last_update, geom) " +
                "VALUES (?, ?, ?, ?, ST_GeomFromText(?, 4326)) " +
                "ON CONFLICT (osm_type, osm_id) " +
                "DO UPDATE SET geom = EXCLUDED.geom, last_update = EXCLUDED.last_update";

        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            for (PoiItem p : poiBatch) {
                ps.setString(1, p.type);
                ps.setLong(2, p.osmId);
                ps.setLong(3, p.uid);
                ps.setTimestamp(4, p.ts);
                ps.setString(5, p.wkt);
                ps.addBatch();
            }
            ps.executeBatch();
        }
    }
    private void insertOsmTags() throws SQLException {
        // Здесь мы ищем внутренний ID по паре (type, osm_id)
        String sql = "INSERT INTO osm_poi_tags (poi_id, tag_key, tag_value) " +
                "SELECT id, ?, ? FROM pois WHERE osm_type = ? AND osm_id = ? " +
                "ON CONFLICT (poi_id, tag_key, tag_value) DO NOTHING";

        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            for (TagItem t : tagBatch) {
                ps.setString(1, t.key);
                ps.setString(2, t.value);
                ps.setString(3, t.type);
                ps.setLong(4, t.osmId);
                ps.addBatch();
            }
            ps.executeBatch();
        }
    }

    private void insertSystemTags() throws SQLException {
        String sql = "INSERT INTO poi_system_tags (poi_id, subcategory_id) " +
                "SELECT id, ? FROM pois WHERE osm_type = ? AND osm_id = ? " +
                "ON CONFLICT DO NOTHING";

        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            for (TagItem t : tagBatch) {
                String lookupKey = t.key + ":" + t.value;
                Integer subId = subcategoryCache.get(lookupKey);

                if (subId != null) {
                    ps.setInt(1, subId);
                    ps.setString(2, t.type);
                    ps.setLong(3, t.osmId);
                    ps.addBatch();
                }
            }
            ps.executeBatch();
        }
    }

    private void insertLangs() throws SQLException {
        String sql = "INSERT INTO pois_langues (poi_id, langue, poi_name, poi_description) " +
                "SELECT id, ?, ?, ? FROM pois WHERE osm_type = ? AND osm_id = ? " +
                "ON CONFLICT (poi_id, langue) DO UPDATE SET " +
                "poi_name = EXCLUDED.poi_name, poi_description = EXCLUDED.poi_description";

        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            for (LangItem l : langBatch) {
                ps.setString(1, l.lang);
                ps.setString(2, l.name);
                ps.setString(3, l.desc);
                ps.setString(4, l.type);
                ps.setLong(5, l.osmId);
                ps.addBatch();
            }
            ps.executeBatch();
        }
    }

    private void clearBatches() {
        poiBatch.clear();
        tagBatch.clear();
        langBatch.clear();
    }

    public void flushBatches() throws SQLException {
        flush();
    }
}
