<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.poi.add.AddPoiActivity"
    android:fitsSystemWindows="true">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/imgPin"
        android:layout_width="@dimen/btn_field"
        android:layout_height="@dimen/btn_field"
        android:src="@drawable/ic_pin"
        android:translationY="-24dp"
        android:contentDescription="Pin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/fieldBtnBack"
        android:layout_width="@dimen/btn_field"
        android:layout_height="@dimen/btn_field"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginStart="@dimen/padding_general"
        android:layout_marginTop="@dimen/padding_general"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:layout_width="@dimen/btn_general"
            android:layout_height="@dimen/btn_general"
            android:layout_gravity="center_vertical"
            android:background="@drawable/btn_general_alpha"
            android:minHeight="36dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_l" />
        </FrameLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/fieldBtnMyPois"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/btn_field"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginEnd="@dimen/padding_general"
        android:layout_marginTop="@dimen/padding_general"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@drawable/btn_general_alpha"
            android:minHeight="36dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/padding_middle"
            android:paddingEnd="@dimen/padding_middle"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="@dimen/icon_general"
                android:layout_height="@dimen/icon_general"
                android:contentDescription="My POIs"
                android:src="@drawable/ic_spot_on" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding_small"
                android:text="Мои POI"
                android:textAppearance="@style/TextAppearance.App.H2"
                android:textColor="@color/white" />
        </LinearLayout>
    </FrameLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="@color/object_orange"
        app:layout_constraintBottom_toTopOf="@+id/imgPin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/general_sheet"
        android:orientation="vertical"
        android:paddingTop="@dimen/padding_normal"
        android:paddingBottom="@dimen/padding_normal"
        android:paddingStart="@dimen/padding_general"
        android:paddingEnd="@dimen/padding_general"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/btnConfirmPoint"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_field"
            android:background="@drawable/btn_next"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Выбрать это место"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.App.H2"
                android:textColor="@color/white" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnToggleSimilarSheet"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_field"
            android:layout_marginTop="@dimen/padding_small"
            android:background="@drawable/btn_general_alpha"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Показать детали"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/white" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_small"
            android:text="Перетащите карту так, чтобы пин указывал на нужное место"
            android:textAppearance="@style/TextAppearance.App.Body2"
            android:textColor="@color/description"
            android:textAlignment="center" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/general"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>