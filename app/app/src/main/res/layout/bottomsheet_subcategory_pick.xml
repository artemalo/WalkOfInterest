<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/general_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/padding_general"
    android:paddingTop="@dimen/padding_normal"
    android:paddingEnd="@dimen/padding_general"
    android:paddingBottom="@dimen/padding_normal">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:background="@drawable/handle_shape" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_middle"
        android:text="Подкатегории"
        android:textAppearance="@style/TextAppearance.App.H2"
        android:textColor="@color/white" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_small"
        android:maxHeight="400dp"
        android:nestedScrollingEnabled="true"
        android:overScrollMode="never" />

    <FrameLayout
        android:id="@+id/btnDone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_field"
        android:layout_marginTop="@dimen/padding_normal"
        android:background="@drawable/btn_next"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Готово"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.App.H2"
            android:textColor="@color/white" />
    </FrameLayout>
</LinearLayout>
