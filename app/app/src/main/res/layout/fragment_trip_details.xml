<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/general"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="yes"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_marginTop="@dimen/padding_general"
        android:paddingStart="@dimen/padding_general"
        android:paddingEnd="@dimen/padding_general"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_field"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fieldBtnTrash"
            android:layout_width="@dimen/btn_field"
            android:layout_height="@dimen/btn_field"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:id="@+id/btnTrash"
                android:layout_width="@dimen/btn_general"
                android:layout_height="@dimen/btn_general"
                android:layout_gravity="center_vertical"
                android:background="@drawable/btn_general_alpha"
                android:minHeight="36dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_trash"
                    app:tint="@color/object_red" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Маршрут"
            android:textAppearance="@style/TextAppearance.App.H1"
            android:textColor="@color/white_gray"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fieldBtnClose"
            android:layout_width="@dimen/btn_field"
            android:layout_height="@dimen/btn_field"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:id="@+id/btnClose"
                android:layout_width="@dimen/btn_general"
                android:layout_height="@dimen/btn_general"
                android:layout_gravity="center_vertical"
                android:background="@drawable/btn_general_alpha"
                android:minHeight="36dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_x" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/general_sheet"
        android:orientation="vertical"
        android:padding="@dimen/padding_general"

        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/imgA"
                android:layout_width="@dimen/icon_general"
                android:layout_height="@dimen/icon_general"
                android:layout_gravity="center"
                android:contentDescription="Point Start"
                app:tint="@color/white_gray"
                android:src="@drawable/ic_a" />
            <TextView
                android:id="@+id/textFrom"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/padding_s_small"
                android:text="Откуда"
                android:textAppearance="@style/TextAppearance.App.Body2"
                android:textColor="@color/white_gray"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/imgB"
                android:layout_width="@dimen/icon_general"
                android:layout_height="@dimen/icon_general"
                android:layout_gravity="center"
                android:contentDescription="Point Start"
                app:tint="@color/white_gray"
                android:src="@drawable/ic_b" />
            <TextView
                android:id="@+id/textTo"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/padding_s_small"
                android:text="Куда"
                android:textAppearance="@style/TextAppearance.App.Body2"
                android:textColor="@color/white_gray"/>
        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="@dimen/padding_normal"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/icon_general">
            <LinearLayout
                android:layout_marginEnd="@dimen/padding_middle"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="@dimen/icon_general"
                    android:layout_height="@dimen/icon_general"
                    app:tint="@color/object"
                    android:src="@drawable/ic_point" />
                <TextView
                    android:id="@+id/timeTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="none"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/white_gray"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/icon_general">
                <ImageView
                    android:layout_width="@dimen/icon_general"
                    android:layout_height="@dimen/icon_general"
                    app:tint="@color/object_orange"
                    android:src="@drawable/ic_clock" />
                <TextView
                    android:id="@+id/timeCurrent"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="none"
                    android:textAlignment="textStart"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/white_gray"/>
            </LinearLayout>
        </LinearLayout>


    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>