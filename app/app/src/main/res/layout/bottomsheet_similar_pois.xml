<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/general_sheet"
    android:paddingStart="@dimen/padding_general"
    android:paddingTop="@dimen/padding_normal"
    android:paddingEnd="@dimen/padding_general"
    android:paddingBottom="@dimen/padding_normal">

    <View
        android:id="@+id/handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/handle_shape"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_middle"
        android:text="Нашли похожие места рядом"
        android:textAppearance="@style/TextAppearance.App.H2"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/handle" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_small"
        android:text="Возможно, ваше место уже добавлено. Откройте существующее или дополните его информацию."
        android:textAppearance="@style/TextAppearance.App.Body2"
        android:textColor="@color/description"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_normal"
        android:layout_marginBottom="@dimen/padding_normal"
        android:overScrollMode="never"

        app:layout_constrainedHeight="true"
        app:layout_constraintHeight_max="@dimen/list_poi_nearby_max"
        app:layout_constraintHeight_min="@dimen/list_poi_nearby_min"

        app:layout_constraintBottom_toTopOf="@+id/btnCreateAnyway"
        app:layout_constraintTop_toBottomOf="@id/tvDescription"
        app:layout_constraintVertical_bias="0.0"
        tools:listitem="@layout/item_similar_poi" />

    <FrameLayout
        android:id="@+id/btnCreateAnyway"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_field"
        android:background="@drawable/btn_field_stroke"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Всё равно создать новое"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.App.H2"
            android:textColor="@color/white" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>