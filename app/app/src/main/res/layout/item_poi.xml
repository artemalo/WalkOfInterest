<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    app:cardBackgroundColor="@color/gray_button"
    app:cardCornerRadius="@dimen/corner_radius_general"
    app:cardElevation="@dimen/padding_small"
    app:strokeWidth="0dp"

    android:layout_width="@dimen/image_poi"
    android:layout_height="wrap_content"

    android:layout_marginEnd="@dimen/padding_general"

    android:clickable="true"
    android:contentDescription="Poi"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgPoi"
            android:layout_width="match_parent"
            android:layout_height="@dimen/image_poi"
            android:layout_gravity="center"
            android:contentDescription="POI image"
            android:scaleType="centerCrop"
            android:src="@color/white_empty"
            app:shapeAppearanceOverlay="@style/RoundedCornerTopStyle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/padding_small"
            android:paddingBottom="@dimen/padding_middle_s"
            android:paddingStart="@dimen/padding_middle_s"
            android:paddingEnd="@dimen/padding_middle_s"
            >

            <TextView
                android:id="@+id/nameCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Название"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/white"/>

            <LinearLayout
                android:id="@+id/ratingContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivRatingStar"
                    android:layout_width="@dimen/icon_general"
                    android:layout_height="@dimen/icon_general"
                    android:contentDescription="Rate avg"
                    android:src="@drawable/ic_star"
                    app:tint="@color/object_star" />

                <TextView
                    android:id="@+id/tvRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="none"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textAppearance="@style/TextAppearance.App.H2"
                    android:textColor="@color/white"
                    tools:text="4.5 (1235)" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>