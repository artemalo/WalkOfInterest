<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/padding_small"
    android:background="@drawable/bg_my_poi_card"
    android:orientation="vertical"
    android:padding="@dimen/padding_middle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Название"
            android:textAppearance="@style/TextAppearance.App.H2"
            android:textColor="@color/white" />
        <TextView
            android:id="@+id/distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_small"
            android:textAppearance="@style/TextAppearance.App.Body2"
            android:textColor="@color/description" />
    </LinearLayout>

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_s_small"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.App.Body2"
        android:textColor="@color/description" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_middle"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/btnOpen"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/btn_general"
            android:background="@drawable/btn_field_stroke"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Открыть"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/white" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/btnAddInfo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/btn_general"
            android:layout_marginStart="@dimen/padding_small"
            android:background="@drawable/btn_next"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Дополнить"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/white" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
