<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/general">

    <!-- Заголовок -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_field"
        android:paddingStart="@dimen/padding_general"
        android:paddingEnd="@dimen/padding_general"
        android:layout_marginTop="@dimen/padding_general"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="Новое место"
            android:textAppearance="@style/TextAppearance.App.H1"
            android:textColor="@color/white"
            app:layout_constraintEnd_toStartOf="@+id/fieldBtnClose"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <FrameLayout
            android:id="@+id/fieldBtnClose"
            android:layout_width="@dimen/btn_field"
            android:layout_height="@dimen/btn_field"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="Close"
                android:src="@drawable/ic_x" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="@dimen/padding_general"
        android:paddingEnd="@dimen/padding_general"
        app:layout_constraintBottom_toTopOf="@+id/btnSubmit"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/padding_normal"
            android:paddingBottom="@dimen/padding_general">

            <!-- Название -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/nameInputLayout"
                style="@style/CompactTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Название места">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="120"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/white" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Описание -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/descriptionInputLayout"
                style="@style/CompactTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_middle"
                android:hint="Описание (необязательно)"
                app:counterEnabled="true"
                app:counterMaxLength="1024">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="1024"
                    android:minLines="3"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/white" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Язык -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_normal"
                android:text="Язык"
                android:textAppearance="@style/TextAppearance.App.H2"
                android:textColor="@color/white_gray" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_small"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btnLangRu"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/btn_field"
                    android:background="@drawable/btn_lang_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Русский"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/btnLangEn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/btn_field"
                    android:layout_marginStart="@dimen/padding_small"
                    android:background="@drawable/btn_lang_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="English"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- Выбранные подкатегории -->
            <TextView
                android:id="@+id/titleSelected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_normal"
                android:text="Выбранные подкатегории"
                android:textAppearance="@style/TextAppearance.App.H2"
                android:textColor="@color/white_gray"
                android:visibility="gone" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSelected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_small"
                app:chipSpacingHorizontal="@dimen/padding_small"
                app:chipSpacingVertical="@dimen/padding_small"
                app:singleLine="false" />

            <!-- Категории -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_normal"
                android:text="Категории"
                android:textAppearance="@style/TextAppearance.App.H2"
                android:textColor="@color/white_gray" />

            <ProgressBar
                android:id="@+id/progressCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/padding_middle"
                android:indeterminateTint="@color/object"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/errorCategoriesBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_middle"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/errorCategoriesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Body2"
                    android:textColor="@color/object_red" />

                <FrameLayout
                    android:id="@+id/btnRetryCategories"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_general"
                    android:layout_marginTop="@dimen/padding_small"
                    android:background="@drawable/btn_field_stroke"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Повторить"
                        android:textAlignment="center"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="@color/white" />
                </FrameLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_small"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_field"
        android:layout_marginStart="@dimen/padding_general"
        android:layout_marginEnd="@dimen/padding_general"
        android:layout_marginBottom="@dimen/padding_normal"
        android:background="@drawable/btn_next"
        android:clickable="true"
        android:focusable="true"
        android:alpha="0.5"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/textBtnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Отправить на модерацию"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.App.H2"
            android:textColor="@color/white" />

        <ProgressBar
            android:id="@+id/progressSubmit"
            android:layout_width="@dimen/btn_general"
            android:layout_height="@dimen/btn_general"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/padding_middle"
            android:indeterminateTint="@color/white"
            android:visibility="gone" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
