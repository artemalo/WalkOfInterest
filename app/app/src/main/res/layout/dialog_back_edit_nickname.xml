<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/field_general_shape_plus"
    android:padding="@dimen/padding_middle">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayout"
        style="@style/CompactTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/padding_normal"
        android:textColorHint="@color/white_hint"
        app:layout_constraintBottom_toTopOf="@+id/btnOkUsername"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
            android:hint="@string/username"
            android:inputType="textNoSuggestions"
            android:maxLines="1"
            android:paddingVertical="@dimen/padding_middle"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColor="@color/white" />
    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout
        android:id="@+id/btnOkUsername"
        android:layout_width="0dp"
        android:layout_height="@dimen/btn_field"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="edit profile"
        app:layout_constraintBottom_toBottomOf="@+id/fieldBtnOkUsername"
        app:layout_constraintEnd_toEndOf="@+id/fieldBtnOkUsername"
        app:layout_constraintStart_toStartOf="@+id/fieldBtnOkUsername"
        app:layout_constraintTop_toTopOf="@+id/fieldBtnOkUsername" />
    <FrameLayout
        android:id="@+id/fieldBtnOkUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_next"
        android:gravity="center"
        android:padding="@dimen/padding_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/textBtnOkUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Изменить"
            android:textAppearance="@style/TextAppearance.App.H2"
            android:textColor="@color/white" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>