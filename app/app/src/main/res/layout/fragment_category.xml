<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:background="@color/general"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/itemList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/padding_normal"
        app:layout_constraintBottom_toTopOf="@+id/bottomSheet"
        app:layout_constraintTop_toBottomOf="@+id/searchBar"
        tools:listitem="@layout/item_subcategory" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_general"
        android:paddingStart="@dimen/padding_general"
        android:paddingEnd="@dimen/padding_general"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/frame_ok_close"
            android:layout_width="@dimen/btn_field"
            android:layout_height="@dimen/btn_field"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnOk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="button back"
                android:src="@drawable/ic_done"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/btnClose"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:contentDescription="button back"
                    android:src="@drawable/ic_arrow_l" />
            </FrameLayout>
        </FrameLayout>



        <TextView
            android:id="@+id/categoryName"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Категория"
            android:textAppearance="@style/TextAppearance.App.H1"
            android:textColor="@color/white_gray"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/frame"
            app:layout_constraintStart_toEndOf="@+id/frame_ok_close"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/frame"
            android:layout_width="@dimen/btn_field"
            android:layout_height="@dimen/btn_field"

            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/searchBar"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_field"
        android:paddingStart="@dimen/padding_general"
        android:paddingEnd="@dimen/padding_general"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <Space
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent"/>

        <ImageButton
            android:id="@+id/btnSwap"
            android:src="@drawable/ic_swap"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/btn_field"
            android:layout_height="@dimen/btn_field"
            android:contentDescription="button swap"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/general_sheet"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_general"
        android:paddingEnd="@dimen/padding_general"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_marginTop="@dimen/padding_normal"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/icon_general">
            <ImageView
                android:id="@+id/imagePoi1"
                android:layout_width="@dimen/icon_general"
                android:layout_height="@dimen/icon_general"
                android:layout_gravity="center"
                android:contentDescription="Point Start"
                android:src="@drawable/ic_point"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/framePicture"
                app:tint="@color/object_not_active" />

            <TextView
                android:id="@+id/allPois"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="none"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/white" />

            <ImageView
                android:id="@+id/imagePoi2"
                android:layout_marginStart="@dimen/padding_s_small"
                android:layout_width="@dimen/icon_general"
                android:layout_height="@dimen/icon_general"
                android:layout_gravity="center"
                android:contentDescription="Point Start"
                android:src="@drawable/ic_point"
                app:tint="@color/object" />

            <TextView
                android:id="@+id/countSelected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="none"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/white" />


            <ImageView
                android:id="@+id/imageView2"
                android:layout_marginStart="@dimen/padding_s_small"
                android:layout_width="@dimen/icon_general"
                android:layout_height="@dimen/icon_general"
                android:layout_gravity="center"
                android:contentDescription="Point Start"
                android:src="@drawable/ic_clock"
                app:tint="@color/object_orange" />

            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="none"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/white" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/fieldBtnEdit"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_field"
            android:layout_marginTop="@dimen/padding_small"
            android:layout_marginBottom="@dimen/padding_normal"
            android:paddingTop="@dimen/padding_small"
            android:paddingBottom="@dimen/padding_small">
            <FrameLayout
                android:id="@+id/btnEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/btn_next"
                android:backgroundTint="@color/object_orange"
                android:minHeight="36dp">
                <TextView
                    android:id="@+id/btnEditText"
                    android:text="Редактировать"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextAppearance.App.H2"
                    android:includeFontPadding="false"/>
            </FrameLayout>
        </FrameLayout>

    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_subcategory"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</androidx.constraintlayout.widget.ConstraintLayout>