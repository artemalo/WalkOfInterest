<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/object_not_active"/>
            <corners
                    android:topLeftRadius="@dimen/corner_field"
                    android:topRightRadius="@dimen/corner_field"/>
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gray_button_selected"/>
            <corners
                    android:topLeftRadius="@dimen/corner_field"
                    android:topRightRadius="@dimen/corner_field"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gray_button"/>
            <corners
                    android:topLeftRadius="@dimen/corner_field"
                    android:topRightRadius="@dimen/corner_field"/>
        </shape>
    </item>
</selector>